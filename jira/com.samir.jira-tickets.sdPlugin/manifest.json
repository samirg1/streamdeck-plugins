{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.samir.jira-tickets",
  "Name": "Jira Tickets",
  "Description": "Shows active Jira tickets on a Stream Deck Mini.",
  "Author": "Samir",
  "Version": "0.3.7.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "20"
  },
  "CodePath": "bin/index.js",
  "Icon": "imgs/plugin-icon",
  "Category": "Jira Tickets",
  "CategoryIcon": "imgs/category-icon",
  "PropertyInspectorPath": "ui/config.html",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.samir.jira-tickets.issue",
      "Name": "Jira Ticket",
      "Icon": "imgs/action-icon",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/config.html",
      "States": [
        {
          "Image": "imgs/action-icon",
          "TitleAlignment": "middle",
          "FontSize": 14
        }
      ]
    }
  ]
}